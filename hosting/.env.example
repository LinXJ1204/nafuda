# Copy to hosting/.env (gitignored).
# Only for the `tunnel` profile (a tunnel of its own). From Cloudflare Zero Trust → Networks → Tunnels.
TUNNEL_TOKEN=
# Host port for the web container (loopback only).
WEB_PORT=8088
# Optional, public: a domain-restricted Sepolia RPC URL (it ends up in the browser bundle).
VITE_SEPOLIA_RPC_URL=
