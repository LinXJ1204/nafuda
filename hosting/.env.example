# Copy to hosting/.env (gitignored). See docs/hosting.md.

# Postgres password (any random string) and the server-side Sepolia RPC (stays on the server)
DB_PASSWORD=
INDEXER_RPC_URL=

# Host ports (loopback only): collector app and grader console
WEB_PORT=8088
GRADER_PORT=8089

# Market simulator (profile "market"). Defaults in compose.yaml: until 2026-09-30 00:00 JST,
# budget 0.1 ETH, one action every 480–900 s.
# MARKET_UNTIL=2026-09-30T00:00:00+09:00

# Second witness: the Curvegrid MultiBaas webhook's signing secret (scripts/src/multibaas.ts)
MULTIBAAS_WEBHOOK_SECRET=

# Only for the "tunnel" profile (a tunnel of its own). From Cloudflare Zero Trust → Networks → Tunnels.
TUNNEL_TOKEN=
